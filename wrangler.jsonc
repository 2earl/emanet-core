{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emanet-core",
  // The 2earl Cloudflare account. An identifier, not a credential; deploys need only the token.
  "account_id": "304c2b77d734c688c8309d5a535f561a",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_als"],

  // No public address. The three Emanet apps reach the EmanetCore entrypoint over Service
  // Bindings (docs/DESIGN.md §2); nothing on the Internet can.
  "workers_dev": false,
  "preview_urls": false,

  // Invocation logs could record vehicle and agent data.
  "observability": {
    "enabled": false,
  },

  // Created in the EU jurisdiction until the pilot partner rules on hosting (docs/DESIGN.md §0);
  // set the ID after the first terraform apply.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emanet",
      "database_id": "9e5fbf19-ed8a-482a-9a74-e54b8157c82c",
      "migrations_dir": "migrations",
    },
  ],

  // All of Emanet's email (docs/DESIGN.md §5, Onboarding), from its own domain: emanet.dev is set
  // up for Cloudflare Email Service sending. Replies go to iletisim@emanet.dev.
  "send_email": [{ "name": "MAILER", "allowed_sender_addresses": ["noreply@emanet.dev"] }],

  // Where onboarding links point, and where staff are told of a signed agreement.
  "vars": {
    "KURUMSAL_ORIGIN": "https://kurumsal.emanet.dev",
    "MERKEZ_ORIGIN": "https://merkez.emanet.dev",
    "STAFF_EMAIL": "iletisim@emanet.dev",
  },

  // Every 5 minutes: expire claims, cases and onboarding links; onboarding reminders
  // (docs/DESIGN.md §5).
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
